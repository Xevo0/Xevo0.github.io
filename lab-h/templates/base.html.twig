
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Moje posty{% endblock %}</title>

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body class="d-flex flex-column min-vh-100">

<header class="site-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 py-4">
        <a href="{{ path('app_post_index') }}" class="logo">
            Moje posty
        </a>

        <nav class="d-flex flex-wrap gap-3">
            <a href="{{ path('app_post_index') }}">Strona główna</a>
            <a href="{{ path('app_post_new') }}">Dodaj post</a>
        </nav>
    </div>
</header>

<main class="container my-5 flex-grow-1">
    {% block body %}{% endblock %}
</main>

<footer class="site-footer text-center py-4">
    <div class="container">
        <strong>Moje Posty</strong>
        <p class="mb-0 mt-2">Posty Posty</p>
    </div>
</footer>

</body>
</html>
