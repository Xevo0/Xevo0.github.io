
<form method="post"
      action="{{ path('app_post_delete', {'id': post.id}) }}"
      onsubmit="return confirm('Czy na pewno chcesz usunąć ten post?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ post.id) }}">

    <button class="btn btn-danger">Usuń</button>
</form>
